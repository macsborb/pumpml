# Copie ce fichier en .env et remplis les valeurs. Ne partage jamais .env.

# Cle PumpPortal (https://pumpportal.fun). Les flux newToken et migration sont gratuits.
PUMPPORTAL_API_KEY=

# Cle Helius (https://dashboard.helius.dev). Sert a recevoir les trades pump.fun on-chain.
HELIUS_API_KEY=

# Optionnel : fournisseur de donnees X/Twitter pour les comptes et tweets lies aux coins.
#   none        : on garde seulement ce qu'on deduit du lien (tweet ou profil, handle)
#   twitterapi  : https://twitterapi.io (cle dans TWITTER_API_KEY)
#   x           : API officielle X v2 (Bearer token dans TWITTER_API_KEY)
TWITTER_PROVIDER=none
TWITTER_API_KEY=

# Optionnel : cle Jupiter gratuite (https://portal.jup.ag) -> 60 cotations/min au lieu de 30.
JUPITER_API_KEY=
